# Optional: a Cesium ion token restricted to your deployed domain and required assets.
# Used for global OSM 3D buildings. Satellite imagery and terrain work without it.
NEXT_PUBLIC_CESIUM_ION_ACCESS_TOKEN=

# Set this in Vercel to the public URL of the persistent Socket.IO backend.
# NEXT_PUBLIC_CONTROL_SERVER_URL=https://control.example.com

# Server-side target for the same-origin Socket.IO proxy if the control server
# is not running on this machine's 127.0.0.1:4100.
# CONTROL_SERVER_PROXY_URL=https://control.example.com
