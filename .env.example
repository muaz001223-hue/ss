# Reference template for the separate Socket.IO backend. Generate unique
# secrets before using these values. `npm run dev` creates a private local .env.
HOST=0.0.0.0
PORT=4100
CORS_ORIGIN=https://your-dashboard.vercel.app
DASHBOARD_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
DEVICE_TOKENS_JSON={"robot-1":"REPLACE_WITH_A_RANDOM_DEVICE_SECRET","sim-robot-1":"REPLACE_WITH_A_DIFFERENT_DEVICE_SECRET"}

# Virtual simulator (software-only).
CONTROL_SERVER_URL=https://control.example.com
SIM_ROBOT_ID=sim-robot-1

# Read-only serial telemetry bridge (run on the PC connected to the Arduino).
SERIAL_SERVER_URL=https://control.example.com
SERIAL_PORT=
SERIAL_ROBOT_ID=robot-1
# SERIAL_DEVICE_TOKEN=use-the-token-configured-for-SERIAL_ROBOT_ID
